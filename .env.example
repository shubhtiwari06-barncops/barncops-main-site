# Barnstorm Co-operations — server environment
# Set these in the Vercel project. Never prefix secrets with VITE_.
# After adding or changing values, redeploy:
#   npm run build
#   npx vercel deploy --prebuilt --prod

# Database (injected on deploy when migrations exist; PGLite fallback in preview)
DATABASE_URL=

# Resend email
RESEND_API_KEY=
FROM_EMAIL=Barnstorm Co-operations <poll@barncops.in>
INTAKE_TO_EMAIL=poll@barncops.in
INFO_TO_EMAIL=poll@barncops.in

# Slack (optional)
SLACK_WEBHOOK_URL=

# Cloudflare Turnstile — required in production
# Create a widget at dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# WhatsApp click-to-chat (public; international digits, no + or spaces)
WHATSAPP_NUMBER=919522236699
WHATSAPP_DEFAULT_MESSAGE=Hello Barnstorm Co-operations, I would like to discuss a confidential mandate.

# WhatsApp Cloud API (one number, one webhook — also serves Atlas)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Atlas pay link the bot sends when a message came from atlas.barncops.in
# Same Razorpay/UPI URL as barncops-atlas PAYMENT_URL, or leave blank to send https://atlas.barncops.in/pay/
ATLAS_PAY_URL=

# Atlas WhatsApp ask (www → Atlas). Same secret as barncops-atlas WA_INTAKE_SECRET.
# Do not use atlas.barncops.in here — Cloudflare challenges that path.
ATLAS_WA_SECRET=
ATLAS_WA_ASK_URL=https://barncops-atlas-git-main-shubhyouth-7062.vercel.app/api/wa-ask/
# Atlas Vercel → Deployment Protection → Protection Bypass for Automation
ATLAS_WA_BYPASS=

# Admin file at /console/intake and /console/whatsapp (header X-Admin-Token)
ADMIN_TOKEN=
