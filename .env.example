# Barnstorm Co-operations — server environment
# Set these in the Vercel project. Never prefix secrets with VITE_.
# After adding or changing values, redeploy:
#   npm run build
#   npx vercel deploy --prebuilt --prod

# Database (injected on deploy when migrations exist; PGLite fallback in preview)
DATABASE_URL=

# Resend email
RESEND_API_KEY=
FROM_EMAIL=Barnstorm Co-operations <poll@barncops.in>
INTAKE_TO_EMAIL=poll@barncops.in
INFO_TO_EMAIL=poll@barncops.in

# Slack (optional)
SLACK_WEBHOOK_URL=

# Cloudflare Turnstile — required in production
# Create a widget at dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# WhatsApp click-to-chat (public; international digits, no + or spaces)
WHATSAPP_NUMBER=919522236699
WHATSAPP_DEFAULT_MESSAGE=Hello Barnstorm Co-operations, I would like to discuss a confidential mandate. #BCteam-web

# WhatsApp Cloud API (one number, one webhook — also serves Atlas)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret that signs webhook POSTs (X-Hub-Signature-256). Either name works;
# META_APP_SECRET wins. With neither set, every webhook POST is refused.
META_APP_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# WhatsApp routing. Both ids equal = one shared number (Ask Atlas by default, team on the tag or
# the "Talk to the team" button). Different ids = Atlas-only number + business number.
# Any other phone_number_id is ignored.
WA_ASK_ATLAS_PHONE_ID=
WA_BUSINESS_PHONE_ID=
WA_BUSINESS_TAG=#BCteam
WA_INQUIRY_WINDOW_HOURS=24
# Send "Checking…" only when the Atlas answer is not back after this many ms
WA_ACK_AFTER_MS=1200

# Team inbox at /admin/wa-inbox (password form; the cookie is derived from this value)
ADMIN_INBOX_PASSWORD=
# Approved utility template sent from the inbox once the 24 h customer window has closed
WA_REPLY_TEMPLATE=
WA_REPLY_TEMPLATE_LANG=en
# Base URL used in inquiry emails for the inbox link
INBOX_BASE_URL=https://www.barncops.in
# Optional: Vercel sends it as a Bearer token on cron calls; /api/wa-warm refuses others when set
CRON_SECRET=

# Atlas pay link the bot sends when a message came from atlas.barncops.in
# Same Razorpay/UPI URL as barncops-atlas PAYMENT_URL, or leave blank to send https://atlas.barncops.in/pay/
ATLAS_PAY_URL=

# Atlas WhatsApp ask (www → Atlas). Same secret as barncops-atlas WA_INTAKE_SECRET.
# Do not use atlas.barncops.in here — Cloudflare challenges that path.
ATLAS_WA_SECRET=
ATLAS_WA_ASK_URL=https://barncops-atlas-git-main-shubhyouth-7062.vercel.app/api/wa-ask/
# Atlas Vercel → Deployment Protection → Protection Bypass for Automation
ATLAS_WA_BYPASS=

# Admin file at /console/intake and /console/whatsapp (header X-Admin-Token)
ADMIN_TOKEN=
